// Toolchain probe: one tiny function per language feature this project
// relies on, each pinned by a forge test asserting exact runtime behavior.
// check-core.sh compiles this file FIRST, so when the pinned toolchain moves
// (rev bump, std change), drift fails here - small and labeled - before your
// real contracts do.
//
// Canaries (each maps to a Counter.solc pattern):
//   constructor + get  constructor args ABI-appended to initcode, storage,
//                      and selector dispatch, end-to-end
//   stored/extra       storage fields lay out sequentially from slot 0, in
//                      declaration order; test/Probe.t.sol pins the slots
//                      with vm.load (what a delegatecall proxy would rely on)
//   demandPositive     require(cond, "message"): the native revert payload
//                      is the RAW message bytes, not Solidity's
//                      Error(string) encoding; test/Probe.t.sol pins that
//                      wire shape
//   bareLit            bare integer literals in non-tail returns
//
// Extend this contract as your project adopts more language features: one
// function per feature, one test per function. The canary is optional: once
// your toolchain is stable, remove it together with test/Probe.t.sol and
// build/Probe.* (see "The canary" in README.md).
import std.{*};
import std.dispatch.{*};

contract Probe {
    stored : uint256;
    extra : uint256;

    constructor(x : uint256) {
        stored = x;
        extra = x + 1;
    }

    public function get() -> uint256 {
        return stored;
    }

    public function getExtra() -> uint256 {
        return extra;
    }

    // require with a runtime-materialized string literal. On failure the
    // revert payload is the raw UTF-8 bytes of the message - deliberately
    // NOT the Solidity Error(string) ABI encoding.
    public function demandPositive(x : uint256) -> uint256 {
        require(x > 0, "Probe: x must be positive");
        return x;
    }

    // Bare literals in non-tail returns, unified against the expected type.
    public function bareLit(x : uint256) -> uint256 {
        if (x > 0) { return 0; }
        return 1;
    }
}
